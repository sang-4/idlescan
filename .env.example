# idlescan — copy to .env and edit. Every value is optional.
#
# The one switch that matters: read-only is the default. Setting it to false
# unlocks the claim hand-off endpoints, which return UNSIGNED transactions for
# your own browser wallet to review and sign. The server never holds keys,
# never signs, and never broadcasts.
IDLESCAN_READ_ONLY=true

# Web server (loopback by default). Non-loopback binds require
# IDLESCAN_AUTH_TOKEN (or IDLESCAN_ALLOW_INSECURE_REMOTE=true with a warning).
IDLESCAN_HOST=127.0.0.1
IDLESCAN_PORT=8787

# SQLite database. Relative paths resolve against the project root.
IDLESCAN_DB=data/idlescan.db

# Comma separated chain keys; empty means every configured chain.
#   idlescan chains
IDLESCAN_CHAINS=

# Hide dust from reports, and rescan automatically every N minutes (0 = manual).
IDLESCAN_MIN_USD=1.0
IDLESCAN_REFRESH_MINUTES=0

# Refuse to enable write mode on a non-loopback host unless you really mean it.
IDLESCAN_ALLOW_REMOTE_WRITE=false

# Extra directory to search for merkle claim datasets.
# IDLESCAN_DATASET_DIR=

# Seed a synthetic portfolio on startup so every screen is populated.
IDLESCAN_DEMO=false

# ---------------------------------------------------------------------------
# Safety: claim hand-off, authentication, remote access
# ---------------------------------------------------------------------------

# Bearer token required for every /api/* request when set. Constant-time
# comparison. Generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
# IDLESCAN_AUTH_TOKEN=

# Allow the server to start on a non-loopback host without a token. Logs a
# prominent warning and shows a persistent UI banner. Not recommended.
IDLESCAN_ALLOW_INSECURE_REMOTE=false

# Local administrative edits (wallet/airdrop changes, alert acks, backups,
# scans) are disabled while locked. Reads, exports and POST /api/check still work.
IDLESCAN_LOCKDOWN=false

# ---------------------------------------------------------------------------
# Rate limits and body limits (WP-04)
# ---------------------------------------------------------------------------

# Maximum request body in bytes (default 1 MiB). JSON routes require
# Content-Type: application/json.
IDLESCAN_MAX_BODY_BYTES=1048576

# Enable rate limiting on loopback too (disabled by default there).
IDLESCAN_RATE_LIMIT_LOOPBACK=false
IDLESCAN_RATE_LIMIT_READ_PER_MINUTE=240
IDLESCAN_RATE_LIMIT_WRITE_PER_MINUTE=60
IDLESCAN_RATE_LIMIT_SCAN_PER_10_MINUTES=12

# ---------------------------------------------------------------------------
# Outbound fetch safety (WP-03): datasets, prices, webhooks
# ---------------------------------------------------------------------------

# Allow plain HTTP and private/loopback addresses for outbound fetches.
# Off by default; explicit opt-in for local fixture testing only.
IDLESCAN_ALLOW_HTTP_FETCH=false

# Max response bytes for any outbound fetch (default 25 MiB).
IDLESCAN_MAX_FETCH_BYTES=26214400

# Connect/read timeout seconds for outbound fetches.
IDLESCAN_FETCH_TIMEOUT_SECONDS=15.0

# Comma-separated exclusive host allowlist for outbound fetches.
# IDLESCAN_FETCH_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Multi-endpoint verification (WP-05)
# ---------------------------------------------------------------------------

# How many distinct RPC endpoints must agree on critical reads (default 1).
# Set to 2+ to fail closed when endpoints disagree.
IDLESCAN_RPC_QUORUM=1

# Per-chain RPC overrides, comma-separated. Takes precedence over bundled URLs.
#   IDLESCAN_RPC_ETHEREUM=https://rpc-a.example.org,https://rpc-b.example.org
#   IDLESCAN_RPC_ARBITRUM=https://arb.example.org
# IDLESCAN_RPC_<CHAINKEY>=

# ---------------------------------------------------------------------------
# Gas model (WP-01) and scan engine (WP-13)
# ---------------------------------------------------------------------------

# Safety buffer percent applied to net value after gas (default 20).
IDLESCAN_GAS_BUFFER_PCT=20

# Bounded thread pool for concurrent chains (default 4).
IDLESCAN_SCAN_WORKERS=4

# Per-scan timeout seconds (default 300).
IDLESCAN_SCAN_TIMEOUT_SECONDS=300

# Flag price_confidence=low when providers disagree by more than this percent.
IDLESCAN_PRICE_DISAGREEMENT_PCT=10.0

# ---------------------------------------------------------------------------
# Dataset provenance and staleness (WP-07)
# ---------------------------------------------------------------------------

# Warn when a claims dataset file is older than this many days (default 30).
# 0 disables staleness warnings.
IDLESCAN_DATASET_STALE_DAYS=30

# ---------------------------------------------------------------------------
# Process logging (WP-08)
# ---------------------------------------------------------------------------

# Log format: text or json.
IDLESCAN_LOG_FORMAT=text
IDLESCAN_LOG_LEVEL=INFO
# Emit one log line per API request (includes request ID).
IDLESCAN_HTTP_LOG=false

# ---------------------------------------------------------------------------
# Alerts and notifications (WP-09)
# ---------------------------------------------------------------------------

# Comma-separated webhook URLs for new alerts (opt-in, off by default).
# IDLESCAN_NOTIFY_WEBHOOK_URLS=
IDLESCAN_NOTIFY_MIN_SEVERITY=warning
IDLESCAN_NOTIFY_KINDS=
IDLESCAN_NOTIFY_DIGEST=false

# ---------------------------------------------------------------------------
# Retention and backups (WP-06)
# ---------------------------------------------------------------------------

# Keep the newest N snapshots (0 keeps all).
IDLESCAN_RETENTION_SNAPSHOTS=90
# Prune acknowledged/detached alerts older than N days (0 keeps all).
IDLESCAN_RETENTION_ALERTS_DAYS=180
IDLESCAN_RETENTION_AUDIT_DAYS=365
IDLESCAN_RETENTION_EXECUTIONS_DAYS=365
IDLESCAN_RETENTION_JOBS_DAYS=30
# Rotate directory backups to the newest N files.
IDLESCAN_BACKUP_KEEP=5
