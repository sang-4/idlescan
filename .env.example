# idlescan — copy to .env and edit. Every value is optional.
#
# The one switch that matters: read-only is the default. Setting it to false
# unlocks the claim hand-off endpoints, which return UNSIGNED transactions for
# your own browser wallet to review and sign. The server never holds keys,
# never signs, and never broadcasts.
IDLESCAN_READ_ONLY=true

# Web server (loopback by default).
IDLESCAN_HOST=127.0.0.1
IDLESCAN_PORT=8787

# SQLite database. Relative paths resolve against the project root.
IDLESCAN_DB=data/idlescan.db

# Comma separated chain keys; empty means every configured chain.
#   idlescan chains
IDLESCAN_CHAINS=

# Hide dust from reports, and rescan automatically every N minutes (0 = manual).
IDLESCAN_MIN_USD=1.0
IDLESCAN_REFRESH_MINUTES=0

# Refuse to enable write mode on a non-loopback host unless you really mean it.
IDLESCAN_ALLOW_REMOTE_WRITE=false

# Extra directory to search for merkle claim datasets.
# IDLESCAN_DATASET_DIR=

# Seed a synthetic portfolio on startup so every screen is populated.
IDLESCAN_DEMO=false
